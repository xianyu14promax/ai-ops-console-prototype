#!/bin/sh
# 并行开发门禁。启用：git config core.hooksPath .githooks
#
# 两道检查：
#   ① 越界——分支只能改自己泳道的文件与样式段（_parallel/guard.cjs）
#   ② 版本号——main 上脚本的 ?v= 必须跟得上文件改动（_check/_ver-check.cjs）
#
# 分支名带泳道：lane/assets、lane/engine …。不带前缀的按 core 算，core 不受 ① 限制。

set -e
br=$(git rev-parse --abbrev-ref HEAD)

case "$br" in
  lane/*) LANE=${br#lane/} ;;
  *)      LANE=core ;;
esac

# lane 分支比 main 看，main 上看工作区
if [ "$LANE" = "core" ]; then
  BASE=HEAD
else
  BASE=main
fi

echo "· 门禁：泳道 $LANE，基线 $BASE"
node _parallel/guard.cjs --lane "$LANE" --base "$BASE" || {
  echo ""
  echo "推送被拦：有改动落在别人的段里。"
  echo "要么挪回自己的文件，要么在 _parallel/lanes.json 里认领那一段再改。"
  exit 1
}

if [ "$br" = "main" ]; then
  node _parallel/ver-check.cjs || {
    echo ""
    echo "推送被拦：main 上有 ?v= 落后于文件改动。"
    echo "跑 node _parallel/ver-check.cjs --bump，把结果一起提交。"
    exit 1
  }
fi

echo "· 门禁通过"
